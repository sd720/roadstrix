{
  "expo": {
    "name": "PotholeDetector",
    "slug": "potholedetector",
    "version": "1.0.0",
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow RoadStrix to use your location to map hazards."
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.shriramkg.potholedetector",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD-PlaceholderRoadStrixKeyInit00"
        }
      }
    },
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "extra": {
      "eas": {
        "projectId": "56125b77-1aa5-4fd3-a8fc-bfdf666a4752"
      }
    }
  }
}
